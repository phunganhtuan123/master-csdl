{
 "title": "Jewelry Shop - PostgreSQL Monitor",
 "uid": "jewelry-monitor",
 "timezone": "browser",
 "refresh": "10s",
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Kết nối đang mở",
   "type": "stat",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT count(*) AS connections FROM pg_stat_activity WHERE datname='jewelry'"
    }
   ]
  },
  {
   "id": 2,
   "title": "Dung lượng DB",
   "type": "stat",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT round(pg_database_size('jewelry')/1024.0/1024.0,1) AS mb"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes"
    }
   }
  },
  {
   "id": 3,
   "title": "Cache hit %",
   "type": "gauge",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT round(100.0*blks_hit/nullif(blks_hit+blks_read,0),2) AS cache_hit FROM pg_stat_database WHERE datname='jewelry'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    }
   }
  },
  {
   "id": 4,
   "title": "Transactions committed",
   "type": "stat",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT xact_commit FROM pg_stat_database WHERE datname='jewelry'"
    }
   ]
  },
  {
   "id": 5,
   "title": "Đơn hôm nay",
   "type": "stat",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT count(*) AS orders FROM orders WHERE created_at >= current_date AND status<>'cancelled'"
    }
   ]
  },
  {
   "id": 6,
   "title": "Doanh thu hôm nay (VNĐ)",
   "type": "stat",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT coalesce(sum(total),0) AS revenue FROM orders WHERE created_at >= current_date AND status<>'cancelled'"
    }
   ]
  },
  {
   "id": 7,
   "title": "Đơn hàng theo giờ (7 ngày)",
   "type": "timeseries",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT date_trunc('hour', created_at) AS time, count(*) AS orders FROM orders WHERE created_at > now() - interval '7 days' GROUP BY 1 ORDER BY 1"
    }
   ]
  },
  {
   "id": 8,
   "title": "Doanh thu theo ngày (30 ngày, materialized view)",
   "type": "timeseries",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::timestamp AS time, revenue FROM mv_sales_daily WHERE day >= current_date-30 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars"
     }
    }
   }
  },
  {
   "id": 9,
   "title": "Top câu SQL tốn thời gian (pg_stat_statements)",
   "type": "table",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 14,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT left(query,120) AS query, calls, round(total_exec_time::numeric,1) AS total_ms, round(mean_exec_time::numeric,3) AS mean_ms FROM pg_stat_statements WHERE query NOT ILIKE '%pg_stat%' ORDER BY total_exec_time DESC LIMIT 15"
    }
   ]
  },
  {
   "id": 10,
   "title": "Index usage (products / orders)",
   "type": "table",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 14,
    "y": 12,
    "w": 10,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT i.indexrelname AS index, am.amname AS type, pg_size_pretty(pg_relation_size(i.indexrelid)) AS size, i.idx_scan AS scans FROM pg_stat_user_indexes i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_am am ON am.oid=c.relam WHERE i.relname IN ('products','customers') ORDER BY i.idx_scan DESC"
    }
   ]
  },
  {
   "id": 11,
   "title": "Partition orders theo tháng (số dòng)",
   "type": "barchart",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT c.relname AS partition, s.n_live_tup AS rows FROM pg_inherits h JOIN pg_class c ON c.oid=h.inhrelid JOIN pg_stat_user_tables s ON s.relid=c.oid WHERE h.inhparent='orders'::regclass ORDER BY 1"
    }
   ]
  },
  {
   "id": 12,
   "title": "Sản phẩm sắp hết hàng (partial index)",
   "type": "table",
   "datasource": {
    "type": "postgres",
    "uid": "jewelry-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT sku, name, stock FROM v_low_stock_products LIMIT 15"
    }
   ]
  }
 ]
}